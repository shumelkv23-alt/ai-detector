# Скопируй этот файл в backend/.env и заполни значениями.
#
# VLM-слой (OpenAI) — опционален. Без OPENAI_API_KEY работают ансамбль
# моделей и весь forensic-анализ; отключается только VLM-проверка водяных
# знаков и текстовые объяснения вердикта.

# Ключ OpenAI. Пусто → VLM-слой выключен, остальное работает.
OPENAI_API_KEY=

# Vision-модель для проверки водяных знаков и объяснений.
OPENAI_VISION_MODEL=gpt-4o

# Таймаут VLM-детекции водяного знака, сек.
VLM_TIMEOUT=30.0

# Таймаут VLM-объяснения вердикта, сек.
VLM_EXPLAIN_TIMEOUT=20.0

# Макс. сторона изображения, отправляемого в VLM, px.
VLM_MAX_IMAGE_DIM=1024
